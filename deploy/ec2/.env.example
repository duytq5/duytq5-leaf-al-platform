# Copy to .env (gitignored) and fill in. On EC2, generate it from SSM Parameter Store.
POSTGRES_USER=al
# URL-safe characters only: it is embedded in the MLflow backend URI.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=al
MLFLOW_DB=mlflow
AWS_REGION=ap-southeast-1
MODELS_BUCKET=al-models
DATA_BUCKET=al-data
# Where Postgres keeps its files. /data is the persistent EBS volume on EC2;
# use ./data when running locally (gitignored).
DATA_DIR=/data
# Label Studio and its Cognito gate. On EC2, write-env.sh fills these from SSM,
# Secrets Manager (leaf-al/label-studio) and the Cognito client.
LS_DOMAIN=localhost
VIEWER_DOMAIN=view.localhost
LS_ADMIN_EMAIL=admin@example.com
LS_ADMIN_PASSWORD=change-me
LS_API_TOKEN=change-me-token
OAUTH2_PROXY_OIDC_ISSUER_URL=https://cognito-idp.ap-southeast-2.amazonaws.com/pool-id
OAUTH2_PROXY_CLIENT_ID=client-id
OAUTH2_PROXY_CLIENT_SECRET=client-secret
OAUTH2_PROXY_COOKIE_SECRET=0123456789abcdef0123456789abcdef
